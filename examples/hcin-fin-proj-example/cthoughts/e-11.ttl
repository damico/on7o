@prefix hcin:  <http://on7o.io/hcin#> .
@prefix hcinf: <http://on7o.io/hcin/financial#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ego:   <urn:hcin:person:> .
@prefix t: <urn:on7o:e11:> .

t:jude a hcin:Person ; hcin:label "Jude" .
t:xyz a hcin:Organization ; hcin:label "XYZ Company" .

t:membership-jude a hcin:Membership ;
    hcin:member          t:jude ;
    hcin:memberOf        t:xyz ;
    hcin:role            "Pilot lead" ;
    hcin:validFrom       "2024-01-01T00:00:00.000Z"^^xsd:dateTime ;
    hcin:knowledgeStatus hcin:Asserted .

t:interaction-jude a hcin:Interaction ;
    hcin:participant     ego:me , t:jude ;
    hcin:interactionType "message" ;
    hcin:occurredAt      "2026-07-14T09:00:00.000Z"^^xsd:dateTime ;
    hcin:knowledgeStatus hcin:Asserted .
