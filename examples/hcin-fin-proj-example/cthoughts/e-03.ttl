@prefix hcin:  <http://on7o.io/hcin#> .
@prefix hcinf: <http://on7o.io/hcin/financial#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ego:   <urn:hcin:person:> .
@prefix t: <urn:on7o:e03:> .

t:karen a hcin:Person ; hcin:label "Karen" .
t:acme a hcin:Organization ; hcin:label "ACME Company" .

t:membership-karen a hcin:Membership ;
    hcin:member          t:karen ;
    hcin:memberOf        t:acme ;
    hcin:role            "Product owner" ;
    hcin:validFrom       "2024-01-01T00:00:00.000Z"^^xsd:dateTime ;
    hcin:knowledgeStatus hcin:Asserted .

t:interaction-karen a hcin:Interaction ;
    hcin:participant     ego:me , t:karen ;
    hcin:interactionType "meeting" ;
    hcin:occurredAt      "2026-08-20T15:00:00.000Z"^^xsd:dateTime ;
    hcin:knowledgeStatus hcin:Asserted .
