@prefix hcin:  <http://on7o.io/hcin#> .
@prefix hcinf: <http://on7o.io/hcin/financial#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ego:   <urn:hcin:person:> .
@prefix t: <urn:on7o:e10:> .

t:mel a hcin:Person ; hcin:label "Mel" .
t:xyz a hcin:Organization ; hcin:label "XYZ Company" .

t:membership-mel a hcin:Membership ;
    hcin:member          t:mel ;
    hcin:memberOf        t:xyz ;
    hcin:role            "Proposals" ;
    hcin:validFrom       "2024-01-01T00:00:00.000Z"^^xsd:dateTime ;
    hcin:knowledgeStatus hcin:Asserted .

t:interaction-mel a hcin:Interaction ;
    hcin:participant     ego:me , t:mel ;
    hcin:interactionType "message" ;
    hcin:occurredAt      "2026-07-21T09:00:00.000Z"^^xsd:dateTime ;
    hcin:knowledgeStatus hcin:Asserted .
