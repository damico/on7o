    hcin:participant     ego:me , t:sam ;
    hcin:interactionType "meeting" ;
    hcin:occurredAt      "2026-05-24T12:40:00.000Z"^^xsd:dateTime ;
    hcin:knowledgeStatus hcin:Asserted .
