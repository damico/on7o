@prefix hcin:  <http://on7o.io/hcin#> .
@prefix hcinf: <http://on7o.io/hcin/financial#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ego:   <urn:hcin:person:> .
@prefix t: <urn:on7o:t007:> .

t:sam a hcin:Person ; hcin:label "Sam" .

t:consultancy a hcinf:FinancialFlow ;
    hcinf:flowSource     ego:me ;
    hcinf:flowTarget     t:sam ;
    hcinf:direction      hcinf:Outflow ;
    hcinf:amount         "2500.00"^^xsd:decimal ;
    hcinf:currency       "BRL" ;
    hcin:occurredAt      "2026-06-01T14:00:00.000Z"^^xsd:dateTime ;
    hcin:knowledgeStatus hcin:Asserted .
