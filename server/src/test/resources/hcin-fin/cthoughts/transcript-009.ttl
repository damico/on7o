@prefix hcin:  <http://on7o.io/hcin#> .
@prefix hcinf: <http://on7o.io/hcin/financial#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ego:   <urn:hcin:person:> .
@prefix t: <urn:on7o:t009:> .

t:bob  a hcin:Person       ; hcin:label "Bob" .
t:acme a hcin:Organization ; hcin:label "ACME Company" .

# Authority that has already ended. It must show up in a projection of March and
# be gone from one of August.
t:revenue-authority a hcinf:FinancialAuthority ;
    hcinf:holder         t:bob ;
    hcinf:organization   t:acme ;
    hcinf:authorityType  hcinf:RevenueAuthority ;
    hcinf:scope          "ACME revenue contracts" ;
    hcin:validFrom       "2026-01-01T00:00:00.000Z"^^xsd:dateTime ;
    hcin:validTo         "2026-06-30T23:59:59.000Z"^^xsd:dateTime ;
    hcin:knowledgeStatus hcin:Asserted .
